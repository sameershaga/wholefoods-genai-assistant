# Local/offline runtime (the default provider mode; no paid services required)
STORE_ASSISTANT_DELIVERY_LOGS_PATH=data/delivery_logs.json
STORE_ASSISTANT_RECIPE_PATH=data/recipes/oat_milk_overnight_oats.html
# Optional PDF or directory of PDFs indexed for supplier-contract questions.
# Leave empty to disable.
STORE_ASSISTANT_SUPPLIER_CONTRACT_PATH=
STORE_ASSISTANT_STATE_DIRECTORY=.local
STORE_ASSISTANT_EMBEDDING_DIMENSIONS=384
STORE_ASSISTANT_EMBEDDING_PROVIDER=local

# Hosted-provider configuration. SDK clients and credential loading are supplied
# by deployment composition; the offline runtime does not select these adapters.
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
OKTA_ISSUER=
OKTA_AUDIENCE=
# Custom Okta claim containing the manager's trusted store scope.
OKTA_STORE_ID_CLAIM=store_id
SLACK_SIGNING_SECRET=
# JSON map from trusted Slack user IDs to local mock-auth access tokens.
STORE_ASSISTANT_SLACK_USER_TOKENS=
